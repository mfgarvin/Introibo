<?xml version="1.0" encoding="UTF-8"?>
<!-- Four pages, written by hand because there is no build step. If a page is
     added to site/, add it here too. Extensionless URLs: Cloudflare Pages
     serves /privacy and /support from privacy.html and support.html, and
     redirects the .html forms to these. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://parishfinder.app/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://parishfinder.app/support</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://parishfinder.app/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
